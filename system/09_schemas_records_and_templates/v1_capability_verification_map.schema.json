{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhaoran2068/governed-research-workflow/schemas/v1_capability_verification_map.schema.json",
  "title": "Governed Research Workflow V1 Capability Verification Map",
  "description": "A v1 freeze verification map. It does not establish public Release, installation, factual truth, access, or human approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_map_schema_version",
    "map_id",
    "source_contract_version",
    "candidate_evidence_status",
    "authority_boundary",
    "verification_requirements",
    "capabilities"
  ],
  "properties": {
    "verification_map_schema_version": {
      "const": "1.0.0"
    },
    "map_id": {
      "const": "governed-research-workflow-v1-capability-verification-map"
    },
    "source_contract_version": {
      "const": "1.0.0"
    },
    "candidate_evidence_status": {
      "enum": [
        "pending_local_full_regression",
        "locally_verified_candidate"
      ]
    },
    "authority_boundary": {
      "$ref": "#/$defs/authority_boundary"
    },
    "verification_requirements": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "safe_relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_claim_owner",
        "verification_map_owner",
        "release_identity_owner",
        "installation_identity_owner"
      ],
      "properties": {
        "capability_claim_owner": {
          "type": "string",
          "minLength": 1
        },
        "verification_map_owner": {
          "type": "string",
          "minLength": 1
        },
        "release_identity_owner": {
          "type": "string",
          "minLength": 1
        },
        "installation_identity_owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "expected_claim_status",
        "candidate_verification_status",
        "verification_test_paths",
        "required_review_types"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^GRW-CAP-[0-9]{3}-[0-9]{2}$"
        },
        "expected_claim_status": {
          "enum": [
            "permitted",
            "forbidden"
          ]
        },
        "candidate_verification_status": {
          "enum": [
            "pending",
            "locally_verified_candidate"
          ]
        },
        "verification_test_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_relative_path"
          }
        },
        "required_review_types": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "interface_scope",
              "negative_boundary",
              "full_regression"
            ]
          }
        }
      }
    }
  }
}
