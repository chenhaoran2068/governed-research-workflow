{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhaoran2068/governed-research-workflow/schemas/voluntary_experience_package.schema.json",
  "title": "Voluntary Metadata-Only Experience Package",
  "description": "Finite caller-selected metadata records. Structural validity does not prove truth, consent, rights, review, safe content, acceptance, withdrawal execution, or transfer safety.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "package_id", "package_revision", "metadata_only", "restricted_content_included", "automated_upload_or_submission", "automated_promotion", "records", "explicit_non_claims", "compatibility"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "voluntary_experience_package"},
    "package_id": {"$ref": "#/$defs/id"},
    "package_revision": {"type": "integer", "minimum": 1},
    "metadata_only": {"const": true},
    "restricted_content_included": {"const": false},
    "automated_upload_or_submission": {"const": false},
    "automated_promotion": {"const": false},
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_record", "contribution_scope_record", "redaction_and_rights_record", "maintainer_review_record", "correction_or_withdrawal_record"],
      "properties": {
        "observation_record": {"$ref": "#/$defs/relative_json_path"},
        "contribution_scope_record": {"$ref": "#/$defs/relative_json_path"},
        "redaction_and_rights_record": {"$ref": "#/$defs/relative_json_path"},
        "maintainer_review_record": {"$ref": "#/$defs/relative_json_path"},
        "correction_or_withdrawal_record": {"$ref": "#/$defs/relative_json_path"}
      }
    },
    "explicit_non_claims": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["truth", "identity", "consent_or_authority", "rights_or_compliance", "safe_content", "acceptance_or_publication", "withdrawal_execution_or_recall", "cross_machine_transfer", "network_upload_or_intake", "automatic_promotion"]}
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_reader_version", "existing_records_unchanged"],
      "properties": {"minimum_reader_version": {"const": "1.0.0"}, "existing_records_unchanged": {"const": true}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "short_text": {"type": "string", "minLength": 1, "maxLength": 500},
    "reference": {"type": "string", "minLength": 1, "maxLength": 256},
    "relative_json_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"},
    "observation_record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "record_type", "generic_summary", "scope", "evidence_reference_labels", "content_boundary"],
      "properties": {"record_id": {"$ref": "#/$defs/id"}, "record_type": {"const": "experience_observation"}, "generic_summary": {"$ref": "#/$defs/short_text"}, "scope": {"$ref": "#/$defs/short_text"}, "evidence_reference_labels": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}, "content_boundary": {"const": "metadata_only"}}
    },
    "contribution_scope_record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "record_type", "voluntary_representation", "intended_use_category", "prohibited_content_acknowledged", "retention_and_withdrawal_limitation_acknowledged", "representation_limit"],
      "properties": {"record_id": {"$ref": "#/$defs/id"}, "record_type": {"const": "experience_contribution_scope"}, "voluntary_representation": {"const": true}, "intended_use_category": {"enum": ["private_maintainer_review", "candidate_consideration_only", "synthetic_trial_only"]}, "prohibited_content_acknowledged": {"const": true}, "retention_and_withdrawal_limitation_acknowledged": {"const": true}, "representation_limit": {"const": "author_representation_not_identity_or_consent_verification"}}
    },
    "redaction_and_rights_record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "record_type", "redaction_representation", "rights_representation", "known_limitations", "prohibited_content_check_representation"],
      "properties": {"record_id": {"$ref": "#/$defs/id"}, "record_type": {"const": "experience_redaction_and_rights"}, "redaction_representation": {"const": "reviewed_not_verified"}, "rights_representation": {"const": "reviewed_not_verified"}, "known_limitations": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/short_text"}}, "prohibited_content_check_representation": {"const": "performed_not_verified"}}
    },
    "maintainer_review_record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "record_type", "review_state", "accountable_human_reference", "decision_basis_references", "automatic_promotion", "representation_limit"],
      "properties": {"record_id": {"$ref": "#/$defs/id"}, "record_type": {"const": "experience_maintainer_review"}, "review_state": {"enum": ["not_reviewed", "keep_private", "request_correction", "reject_for_shared_use", "eligible_for_candidate_consideration", "withdrawn_from_future_use"]}, "accountable_human_reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "decision_basis_references": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}, "automatic_promotion": {"const": false}, "representation_limit": {"const": "review_record_not_acceptance_publication_or_promotion"}}
    },
    "correction_or_withdrawal_record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "record_type", "request_state", "requested_action", "affected_record_ids", "accountable_human_decision_reference", "future_use_state", "limitation"],
      "properties": {"record_id": {"$ref": "#/$defs/id"}, "record_type": {"const": "experience_correction_or_withdrawal"}, "request_state": {"enum": ["no_request", "correction_requested", "withdrawal_requested", "human_disposition_recorded", "future_use_stopped", "not_reviewed"]}, "requested_action": {"enum": ["none", "correction", "withdrawal"]}, "affected_record_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "accountable_human_decision_reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "future_use_state": {"enum": ["not_requested", "pending_human_decision", "stopped_after_human_decision"]}, "limitation": {"const": "does_not_delete_or_recall_prior_copies"}}
    }
  }
}
