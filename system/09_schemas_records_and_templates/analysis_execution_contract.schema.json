{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhaoran2068/governed-research-workflow/schemas/analysis_execution_contract.schema.json",
  "title": "Future Study Analysis Execution Contract",
  "type": "object",
  "required": [
    "record_type",
    "contract_version",
    "project_id",
    "primary_system",
    "system_contract_reference",
    "contract_status",
    "approval_reference",
    "formal_execution_path",
    "environment_policy",
    "run_policy",
    "result_authority_policy"
  ],
  "$defs": {
    "project_relative_reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*\\.\\.).+$"
    }
  },
  "properties": {
    "record_type": {"const": "analysis_execution_contract"},
    "contract_version": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "primary_system": {"type": "string", "minLength": 1},
    "system_contract_reference": {
      "type": "string",
      "minLength": 1,
      "description": "A separately governed system-contract identity or explicit unresolved placeholder; it is not a Study artifact path."
    },
    "contract_status": {
      "type": "string",
      "enum": ["draft", "candidate", "approved_for_use", "retired"]
    },
    "approval_reference": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "design_and_classification_record_reference": {
      "anyOf": [{"$ref": "#/$defs/project_relative_reference"}, {"type": "null"}]
    },
    "governance_readiness_record_reference": {
      "anyOf": [{"$ref": "#/$defs/project_relative_reference"}, {"type": "null"}]
    },
    "analysis_state_and_freeze_decision_reference": {
      "anyOf": [{"$ref": "#/$defs/project_relative_reference"}, {"type": "null"}]
    },
    "formal_execution_path": {
      "type": "object",
      "required": ["kind", "entrypoint_reference", "declared_only"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["unselected", "python", "r", "sql", "workflow_engine", "controlled_runbook", "other"]
        },
        "entrypoint_reference": {
          "anyOf": [
            {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*\\.\\.).+$"},
            {"type": "null"}
          ]
        },
        "declared_only": {"const": true}
      },
      "additionalProperties": true
    },
    "environment_policy": {
      "type": "object",
      "required": ["environment_spec_reference", "dependency_lock_reference", "automatic_dependency_change_forbidden"],
      "properties": {
        "environment_spec_reference": {
          "anyOf": [
            {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*\\.\\.).+$"},
            {"type": "null"}
          ]
        },
        "dependency_lock_reference": {
          "anyOf": [
            {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*\\.\\.).+$"},
            {"type": "null"}
          ]
        },
        "automatic_dependency_change_forbidden": {"const": true}
      },
      "additionalProperties": true
    },
    "run_policy": {
      "type": "object",
      "required": ["unique_run_id_required", "overwrite_forbidden", "run_manifest_required"],
      "properties": {
        "unique_run_id_required": {"const": true},
        "overwrite_forbidden": {"const": true},
        "run_manifest_required": {"const": true}
      },
      "additionalProperties": true
    },
    "result_authority_policy": {
      "type": "object",
      "required": ["result_manifest_required", "qa_record_required", "human_decision_required"],
      "properties": {
        "result_manifest_required": {"const": true},
        "qa_record_required": {"const": true},
        "human_decision_required": {"const": true}
      },
      "additionalProperties": true
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"contract_version": {"const": "2.0.0"}}, "required": ["contract_version"]},
      "then": {"required": ["design_and_classification_record_reference", "governance_readiness_record_reference", "analysis_state_and_freeze_decision_reference"]}
    },
    {
      "if": {"properties": {"contract_version": {"const": "2.0.0"}, "contract_status": {"const": "approved_for_use"}}, "required": ["contract_version", "contract_status"]},
      "then": {
        "properties": {
          "approval_reference": {"$ref": "#/$defs/project_relative_reference"},
          "design_and_classification_record_reference": {"$ref": "#/$defs/project_relative_reference"},
          "governance_readiness_record_reference": {"$ref": "#/$defs/project_relative_reference"},
          "analysis_state_and_freeze_decision_reference": {"$ref": "#/$defs/project_relative_reference"}
        }
      }
    }
  ],
  "additionalProperties": true
}
