{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhaoran2068/governed-research-workflow/schemas/lesson_promotion_control_bundle.schema.json",
  "title": "Governed Research Workflow Lesson Promotion Control Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_type",
    "bundle_id",
    "metadata_only",
    "restricted_content_included",
    "promotion_control",
    "records"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "bundle_type": {"const": "lesson_promotion_control_bundle"},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "metadata_only": {"const": true},
    "restricted_content_included": {"const": false},
    "promotion_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated_promotion"],
      "properties": {"automated_promotion": {"const": false}}
    },
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.0.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "not": {
          "properties": {
            "records": {
              "contains": {
                "anyOf": [
                  {
                    "required": ["record_type", "decision_history_ids"],
                    "properties": {"record_type": {"const": "lesson_candidate"}}
                  },
                  {
                    "required": ["record_type", "disposition"],
                    "properties": {
                      "record_type": {"const": "human_decision"},
                      "disposition": {"const": "confirm_correction"}
                    }
                  },
                  {
                    "required": ["record_type", "event_date"],
                    "properties": {"record_type": {"const": "change_event"}}
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "reference": {"type": "string", "minLength": 1, "maxLength": 512},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_type", "observation_class", "summary", "scope", "evidence_references", "content_boundary"],
      "properties": {
        "record_id": {"$ref": "#/$defs/identifier"},
        "record_type": {"const": "observation"},
        "observation_class": {"enum": ["recorded_process_fact", "observed_pattern", "working_explanation", "local_note"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "scope": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
        "content_boundary": {"const": "metadata_only"}
      }
    },
    "lesson_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_type", "observation_ids", "candidate_statement", "applicability", "exclusions", "proposed_integration_target", "lifecycle_status", "human_decision_id", "integration_verification_id", "superseded_by_candidate_id"],
      "properties": {
        "record_id": {"$ref": "#/$defs/identifier"},
        "record_type": {"const": "lesson_candidate"},
        "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "candidate_statement": {"type": "string", "minLength": 1, "maxLength": 2000},
        "applicability": {"type": "string", "minLength": 1, "maxLength": 1000},
        "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "proposed_integration_target": {"$ref": "#/$defs/reference"},
        "lifecycle_status": {"enum": ["local_only", "under_review", "deferred", "rejected", "approved_for_integration", "integrated", "withdrawn", "superseded"]},
        "human_decision_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "integration_verification_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "superseded_by_candidate_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "decision_history_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_type", "candidate_id", "disposition", "accountable_human_reference", "decision_basis_references", "decision_date", "representation"],
      "properties": {
        "record_id": {"$ref": "#/$defs/identifier"},
        "record_type": {"const": "human_decision"},
        "candidate_id": {"$ref": "#/$defs/identifier"},
        "disposition": {"enum": ["keep_local", "defer", "reject", "approve_for_integration", "withdraw", "supersede", "confirm_correction"]},
        "accountable_human_reference": {"$ref": "#/$defs/reference"},
        "decision_basis_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
        "decision_date": {"type": "string", "format": "date"},
        "representation": {"const": "recorded_accountable_human_decision_not_identity_verified"}
      }
    },
    "integration_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_type", "candidate_id", "human_decision_id", "target_reference", "validation_evidence_references", "integration_status", "non_claim"],
      "properties": {
        "record_id": {"$ref": "#/$defs/identifier"},
        "record_type": {"const": "integration_verification"},
        "candidate_id": {"$ref": "#/$defs/identifier"},
        "human_decision_id": {"$ref": "#/$defs/identifier"},
        "target_reference": {"$ref": "#/$defs/reference"},
        "validation_evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
        "integration_status": {"enum": ["verified", "not_verified"]},
        "non_claim": {"const": "does_not_prove_target_correctness_or_future_compliance"}
      }
    },
    "change_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_type", "candidate_id", "human_decision_id", "change_type", "reason", "successor_candidate_id"],
      "properties": {
        "record_id": {"$ref": "#/$defs/identifier"},
        "record_type": {"const": "change_event"},
        "candidate_id": {"$ref": "#/$defs/identifier"},
        "human_decision_id": {"$ref": "#/$defs/identifier"},
        "change_type": {"enum": ["correction", "withdrawal", "supersession"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "successor_candidate_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "event_date": {"type": "string", "format": "date"}
      }
    },
    "record": {
      "oneOf": [
        {"$ref": "#/$defs/observation"},
        {"$ref": "#/$defs/lesson_candidate"},
        {"$ref": "#/$defs/human_decision"},
        {"$ref": "#/$defs/integration_verification"},
        {"$ref": "#/$defs/change_event"}
      ]
    }
  }
}
