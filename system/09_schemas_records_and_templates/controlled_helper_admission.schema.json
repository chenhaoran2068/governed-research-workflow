{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhaoran2068/governed-research-workflow/schemas/controlled_helper_admission.schema.json",
  "title": "Governed Research Workflow Controlled Helper Admission",
  "description": "A bounded generic helper-admission record. It is not per-run approval, M53 authorization, data authority, Release authority, or operating-system enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "helper_id",
    "helper_version",
    "record_revision",
    "admission_status",
    "owner",
    "purpose",
    "source_identity",
    "supported_profiles",
    "input_boundary",
    "allowed_action_boundary",
    "write_boundary",
    "forbidden_action_boundary",
    "confirmation_boundary",
    "recovery_boundary",
    "data_credential_network_boundary",
    "audit_and_receipt_boundary",
    "evidence_references",
    "known_limitations",
    "accountable_human_admission",
    "explicit_non_claims",
    "compatibility"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "record_type": {"const": "controlled_helper_admission"},
    "helper_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "helper_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "record_revision": {"type": "integer", "minimum": 1},
    "admission_status": {"enum": ["draft", "candidate", "admitted", "retired"]},
    "owner": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_relative_path", "content_hash_algorithm", "sha256", "identity_scope"],
      "properties": {
        "repository_relative_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "content_hash_algorithm": {"enum": ["sha256_raw_bytes_v1", "sha256_utf8_lf_v1"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "identity_scope": {"type": "string", "minLength": 1}
      }
    },
    "supported_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["standalone", "framework_integrated"]}},
    "input_boundary": {"$ref": "#/$defs/boundary_object"},
    "allowed_action_boundary": {"$ref": "#/$defs/boundary_object"},
    "write_boundary": {"$ref": "#/$defs/boundary_object"},
    "forbidden_action_boundary": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confirmation_boundary": {"$ref": "#/$defs/boundary_object"},
    "recovery_boundary": {"$ref": "#/$defs/boundary_object"},
    "data_credential_network_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_content_access", "credential_access", "network_access", "external_service_action"],
      "properties": {
        "data_content_access": {"const": false},
        "credential_access": {"const": false},
        "network_access": {"const": false},
        "external_service_action": {"const": false}
      }
    },
    "audit_and_receipt_boundary": {"$ref": "#/$defs/boundary_object"},
    "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "known_limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "accountable_human_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference"],
      "properties": {
        "status": {"enum": ["not_granted", "granted", "withdrawn"]},
        "reference": {"type": ["string", "null"]}
      }
    },
    "explicit_non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["older_package_behavior", "framework_installation_claim"],
      "properties": {
        "older_package_behavior": {"const": "unsupported_metadata_no_behavior_change"},
        "framework_installation_claim": {"const": false}
      }
    }
  },
  "$defs": {
    "boundary_object": {
      "type": "object",
      "additionalProperties": {"type": ["string", "boolean", "array", "null"]},
      "minProperties": 1
    }
  }
}
