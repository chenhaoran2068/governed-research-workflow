{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-research-workflow.example/schemas/experience-mapping-decision.schema.json",
  "title": "Experience Mapping Decision",
  "description": "A representation of an accountable-human mapping decision. It cannot authenticate a person, verify authority, verify source content, or promote an experience.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "decision_id",
    "metadata_only",
    "source_id",
    "term_ids",
    "decision_state",
    "scope_note",
    "basis_reference_ids",
    "accountable_human_reference"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "experience_mapping_decision"},
    "decision_id": {"type": "string", "pattern": "^XMD-[0-9]{6}$"},
    "metadata_only": {"const": true},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]{3,64}$"},
    "term_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^XVT-[0-9]{6}$"}},
    "decision_state": {"enum": ["map", "hold", "decline", "needs_review"]},
    "scope_note": {"type": "string", "minLength": 1},
    "basis_reference_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "accountable_human_reference": {"type": "string", "minLength": 1}
  }
}
