{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhaoran2068/governed-research-workflow/schemas/workflow_evidence_control_baseline.schema.json",
  "title": "Workflow And Evidence Control Bundle Baseline Manifest",
  "description": "An optional caller-supplied comparison input. It is not a governance record, trusted authority, tamper-proof store, or release approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "baseline_id",
    "bundle_id",
    "bundle_revision",
    "identity_method_id",
    "canonical_content_sha256",
    "identity_scope_statement",
    "produced_at",
    "producer_reference"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "workflow_evidence_control_baseline"},
    "baseline_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "bundle_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "bundle_revision": {"type": "integer", "minimum": 1},
    "identity_method_id": {"const": "workflow_evidence_control_canonical_json_sha256_v1"},
    "canonical_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity_scope_statement": {"type": "string", "minLength": 1, "maxLength": 1000},
    "produced_at": {"type": "string", "format": "date-time"},
    "producer_reference": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
