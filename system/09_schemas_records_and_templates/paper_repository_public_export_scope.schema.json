{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-research-orchestration/paper_repository_public_export_scope.schema.json",
  "title": "Paper Repository Public Export Scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "study_id", "candidate_id", "source_root_reference", "destination_reference", "include", "exclude_categories", "allowed_generated_derivatives", "review"],
  "$defs": {"reference": {"type": "string", "minLength": 1, "maxLength": 512}},
  "properties": {
    "record_type": {"const": "paper_repository_public_export_scope"},
    "schema_version": {"const": "0.1.0"},
    "study_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "source_root_reference": {"$ref": "#/$defs/reference"},
    "destination_reference": {"$ref": "#/$defs/reference"},
    "include": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_reference", "destination_reference", "mode", "reason"],
        "properties": {
          "source_reference": {"$ref": "#/$defs/reference"},
          "destination_reference": {"$ref": "#/$defs/reference"},
          "mode": {"const": "copy"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "exclude_categories": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["category", "reason"], "properties": {"category": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}
    },
    "allowed_generated_derivatives": {"type": "array", "items": {"type": "object"}},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "rights_status", "privacy_status", "coauthor_status"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "rights_status": {"enum": ["pending", "passed", "failed", "not_applicable"]},
        "privacy_status": {"enum": ["pending", "passed", "failed", "not_applicable"]},
        "coauthor_status": {"enum": ["pending", "passed", "failed", "not_applicable"]}
      }
    }
  }
}
