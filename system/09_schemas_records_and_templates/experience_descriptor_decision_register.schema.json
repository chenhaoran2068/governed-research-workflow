{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-research-workflow.example/schemas/experience-descriptor-decision-register.schema.json",
  "title": "Experience Descriptor Decision Register",
  "description": "A metadata-only representation of an accountable-human descriptor decision. It does not prove source truth, source access, currentness, human identity, authority, maturity, reuse, promotion, integration, or permission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "register_id", "metadata_only", "register_state", "catalogue_id", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "experience_descriptor_decision_register"},
    "register_id": {"type": "string", "pattern": "^XDR-[0-9]{6}$"},
    "metadata_only": {"const": true},
    "register_state": {"enum": ["active_empty", "active"]},
    "catalogue_id": {"type": "string", "pattern": "^XDC-[0-9]{6}$"},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
  },
  "allOf": [
    {"if": {"properties": {"register_state": {"const": "active_empty"}}}, "then": {"properties": {"decisions": {"maxItems": 0}}}},
    {"if": {"properties": {"register_state": {"const": "active"}}}, "then": {"properties": {"decisions": {"minItems": 1}}}}
  ],
  "$defs": {
    "descriptor_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_ids", "record_kind_id", "task_trigger_ids", "target_object_ids", "scope_id"],
      "properties": {
        "domain_ids": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^XDV-[A-Z]{3}-[0-9]{6}$"}},
        "record_kind_id": {"type": "string", "pattern": "^XDV-[A-Z]{3}-[0-9]{6}$"},
        "task_trigger_ids": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^XDV-[A-Z]{3}-[0-9]{6}$"}},
        "target_object_ids": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^XDV-[A-Z]{3}-[0-9]{6}$"}},
        "scope_id": {"type": "string", "pattern": "^XDV-[A-Z]{3}-[0-9]{6}$"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "source_id", "final_disposition", "descriptor_profile", "topic_term_ids", "concise_reason", "reviewed_on", "accountable_human_reference", "limitations_and_reconsideration_trigger"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^XDD-[0-9]{6}$"},
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]{3,64}$"},
        "final_disposition": {"enum": ["described", "deferred", "blocked"]},
        "descriptor_profile": {"oneOf": [{"$ref": "#/$defs/descriptor_profile"}, {"type": "null"}]},
        "topic_term_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^XVT-[0-9]{6}$"}},
        "concise_reason": {"type": "string", "minLength": 1, "maxLength": 280, "pattern": "^[^\\r\\n]+$"},
        "reviewed_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "accountable_human_reference": {"type": "string", "minLength": 1},
        "limitations_and_reconsideration_trigger": {"type": "string", "minLength": 1, "maxLength": 280, "pattern": "^[^\\r\\n]+$"}
      },
      "allOf": [
        {"if": {"properties": {"final_disposition": {"const": "described"}}}, "then": {"properties": {"descriptor_profile": {"type": "object"}}}, "else": {"properties": {"descriptor_profile": {"type": "null"}, "topic_term_ids": {"maxItems": 0}}}}
      ]
    }
  }
}
