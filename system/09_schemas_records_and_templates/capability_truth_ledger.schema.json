{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhaoran2068/governed-research-workflow/schemas/capability_truth_ledger.schema.json",
  "title": "Governed Research Workflow Capability Truth Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_schema_version",
    "ledger_id",
    "ledger_status",
    "release_context",
    "target_claim_scope",
    "claim_admission_rule",
    "contradiction_refusal_rule",
    "contradiction_decision_brief_requirements",
    "capabilities"
  ],
  "properties": {
    "ledger_schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "ledger_id": {"const": "governed-research-workflow-capability-truth-ledger"},
    "ledger_status": {"enum": ["unreleased_candidate", "release_candidate", "release_source_prepared", "released", "superseded"]},
    "release_context": {"$ref": "#/$defs/release_context"},
    "target_claim_scope": {"type": "string", "minLength": 1},
    "claim_admission_rule": {"type": "string", "minLength": 1},
    "contradiction_refusal_rule": {"type": "string", "minLength": 1},
    "contradiction_decision_brief_requirements": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "release_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_release_version", "historical_public_baseline", "live_release_identity_rule"],
      "properties": {
        "source_release_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "historical_public_baseline": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "live_release_identity_rule": {"type": "string", "minLength": 1}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "public_name",
        "capability_class",
        "implementation_status",
        "release_disposition",
        "public_claim_status",
        "promise",
        "non_promise",
        "approval_owner",
        "interface",
        "profile_scope",
        "data_and_external_boundary",
        "evidence",
        "version",
        "prior_release_history",
        "approval_reference",
        "claim_surfaces",
        "contradiction_refusal",
        "limitations_and_next_action"
      ],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^GRW-CAP-(031|040|050|060|070|080|090|100|101|110|111|120|130|140|150|160|170|180|190|200|210|220|230|240)-[0-9]{2}$"},
        "public_name": {"type": "string", "minLength": 1},
        "capability_class": {"enum": ["routing", "helper", "record", "profile", "role_card", "assurance", "release_control"]},
        "implementation_status": {"enum": ["planned", "implemented", "verified", "deferred", "retired"]},
        "release_disposition": {"enum": ["candidate", "admitted", "excluded", "superseded"]},
        "public_claim_status": {"enum": ["permitted", "forbidden"]},
        "promise": {"type": "string", "minLength": 1},
        "non_promise": {"type": "string", "minLength": 1},
        "approval_owner": {"const": "accountable_human"},
        "interface": {"$ref": "#/$defs/interface"},
        "profile_scope": {"enum": ["standalone", "framework_integrated", "both", "not_profile_specific"]},
        "data_and_external_boundary": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["no_data_access", "metadata_only", "synthetic_only", "no_external_service_action"]}
        },
        "evidence": {"$ref": "#/$defs/evidence"},
        "version": {"$ref": "#/$defs/version"},
        "prior_release_history": {"type": "array", "items": {"$ref": "#/$defs/prior_release"}},
        "approval_reference": {"type": ["string", "null"]},
        "claim_surfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contradiction_refusal": {"type": "string", "minLength": 1},
        "limitations_and_next_action": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"public_claim_status": {"const": "permitted"}}, "required": ["public_claim_status"]},
          "then": {
            "properties": {
              "implementation_status": {"const": "verified"},
              "release_disposition": {"const": "admitted"},
              "approval_reference": {"type": "string", "minLength": 1},
              "evidence": {
                "properties": {
                  "status": {"const": "verified"},
                  "references": {"minItems": 1}
                }
              }
            }
          }
        }
      ]
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "paths", "identifiers"],
      "properties": {
        "status": {"enum": ["present", "planned"]},
        "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "identifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "references"],
      "properties": {
        "status": {"enum": ["unverified", "verified", "expired", "not_applicable"]},
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "identifier"],
            "properties": {
              "kind": {"enum": ["test", "manual_review", "integration", "release_record", "run_record"]},
              "path": {"type": "string", "minLength": 1},
              "identifier": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["introduced_version", "last_verified_release", "target_release"],
      "properties": {
        "introduced_version": {"type": ["string", "null"]},
        "last_verified_release": {
          "type": ["string", "null"],
          "description": "The latest formal public Release whose complete capability verification evidence is recorded; it is not an installed-runtime, current-version, or future-release claim."
        },
        "target_release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "prior_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_version", "public_claim_status"],
      "properties": {
        "release_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "public_claim_status": {"enum": ["permitted", "forbidden"]}
      }
    }
  }
}
