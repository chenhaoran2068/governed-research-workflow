{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhaoran2068/governed-research-workflow/schemas/data_provenance_register_set_index.schema.json",
  "title": "Metadata-Only Data And Provenance Register Set Index",
  "description": "An index of metadata-only entry records. It does not contain, access, process, or authorize data content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "register_id",
    "register_revision",
    "recorded_at",
    "metadata_only",
    "entry_contract",
    "validation_boundary",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "data_provenance_register_set_index"},
    "register_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "register_revision": {"type": "integer", "minimum": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "metadata_only": {"const": true},
    "entry_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version"],
      "properties": {
        "record_type": {"const": "data_provenance_register_entry"},
        "schema_version": {"const": "1.0.0"}
      }
    },
    "validation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural_validation_only", "not_an_access_or_compliance_determination"],
      "properties": {
        "structural_validation_only": {"const": true},
        "not_an_access_or_compliance_determination": {"const": true}
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "entry_path"],
        "properties": {
          "record_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
          "entry_path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
