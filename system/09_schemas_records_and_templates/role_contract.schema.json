{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhaoran2068/governed-research-workflow/schemas/role_contract.schema.json",
  "title": "Governed Research Workflow Non-Runnable Role Contract",
  "description": "A bounded documentation record for a review perspective. It is not an agent runtime, tool grant, task authorization, or approval source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "role_id",
    "contract_version",
    "record_revision",
    "contract_status",
    "role_name",
    "purpose",
    "trigger_conditions",
    "accountable_owner",
    "authoritative_inputs",
    "allowed_outputs",
    "prohibited_actions",
    "tool_and_action_boundary",
    "memory_and_retention_boundary",
    "human_decision_points",
    "stop_and_escalation_conditions",
    "audit_record_requirements",
    "explicit_non_claims",
    "evidence_references",
    "compatibility"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "governed_role_contract"},
    "role_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "record_revision": {"type": "integer", "minimum": 1},
    "contract_status": {"enum": ["draft", "reviewed", "admitted", "retired"]},
    "role_name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "trigger_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "accountable_owner": {"type": "string", "minLength": 1},
    "authoritative_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_input_classes", "automatic_discovery_permitted", "unlisted_or_undisclosed_input_policy"],
      "properties": {
        "allowed_input_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["caller_supplied_synthetic_structured_record", "caller_supplied_metadata_only_structured_record", "caller_supplied_public_package_record", "caller_supplied_public_claim", "caller_supplied_evidence_reference"]}
        },
        "automatic_discovery_permitted": {"const": false},
        "unlisted_or_undisclosed_input_policy": {"const": "stop_and_escalate"}
      }
    },
    "allowed_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_classes", "may_mutate", "may_issue_action_command"],
      "properties": {
        "output_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["structural_validation_report", "bounded_finding_list"]}},
        "may_mutate": {"const": false},
        "may_issue_action_command": {"const": false}
      }
    },
    "prohibited_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "tool_and_action_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_access", "credential_access", "external_service_access", "data_content_access", "file_write", "helper_invocation", "project_state_change", "release_or_submission_action"],
      "properties": {
        "network_access": {"const": false},
        "credential_access": {"const": false},
        "external_service_access": {"const": false},
        "data_content_access": {"const": false},
        "file_write": {"const": false},
        "helper_invocation": {"const": false},
        "project_state_change": {"const": false},
        "release_or_submission_action": {"const": false}
      }
    },
    "memory_and_retention_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistent_memory_store_created", "unrecorded_private_memory_as_authority"],
      "properties": {
        "persistent_memory_store_created": {"const": false},
        "unrecorded_private_memory_as_authority": {"const": false}
      }
    },
    "human_decision_points": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stop_and_escalation_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "audit_record_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_be_recorded", "record_location_policy"],
      "properties": {
        "must_be_recorded": {"const": true},
        "record_location_policy": {"type": "string", "minLength": 1}
      }
    },
    "explicit_non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_profiles", "older_package_behavior"],
      "properties": {
        "supported_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["standalone", "framework_integrated"]}},
        "older_package_behavior": {"const": "unsupported_metadata_no_behavior_change"}
      }
    }
  }
}
