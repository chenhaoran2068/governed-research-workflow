{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhaoran2068/governed-research-workflow/assets/public-experience-derivatives/schemas/public_experience_card.schema.json",
  "title": "Public Experience Card Front Matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "public_experience_id",
    "legacy_public_identifier",
    "content_kind",
    "title",
    "primary_public_topic",
    "optional_secondary_topics",
    "applicable_context",
    "generic_experience",
    "recommended_behavior",
    "exclusions_and_stop_conditions",
    "related_public_system_guidance",
    "reviewed_on",
    "public_package_version",
    "status"
  ],
  "properties": {
    "public_experience_id": {"type": "string", "pattern": "^GRW-EXP-[0-9]{3}$"},
    "legacy_public_identifier": {"type": ["string", "null"], "pattern": "^KGE-[0-9]{3}$"},
    "content_kind": {"enum": ["adapted_public_experience_rule", "redacted_historical_experience_note"]},
    "title": {"type": "string", "minLength": 1},
    "primary_public_topic": {"type": "string", "pattern": "^GRW-TOP-[0-9]{3}$"},
    "optional_secondary_topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^GRW-TOP-[0-9]{3}$"}
    },
    "applicable_context": {"type": "string", "minLength": 1},
    "generic_experience": {"type": "string", "minLength": 1},
    "recommended_behavior": {"type": "string", "minLength": 1},
    "exclusions_and_stop_conditions": {"type": "string", "minLength": 1},
    "related_public_system_guidance": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reviewed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "public_package_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "current_public_guidance"}
  }
}
