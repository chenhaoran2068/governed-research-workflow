{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhaoran2068/governed-research-workflow/assets/public-experience-derivatives/schemas/public_experience_vocabulary.schema.json",
  "title": "Public Experience Vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vocabulary_version", "status", "terms"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "vocabulary_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "current_public"},
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/term"}
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_topic_id",
        "canonical_term",
        "chinese_explanation",
        "definition",
        "scope_note",
        "exclusions",
        "permitted_aliases",
        "broader_topic_id",
        "term_status",
        "introduced_in",
        "deprecated_by"
      ],
      "properties": {
        "public_topic_id": {"type": "string", "pattern": "^GRW-TOP-[0-9]{3}$"},
        "canonical_term": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "chinese_explanation": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "scope_note": {"type": "string", "minLength": 1},
        "exclusions": {"type": "string", "minLength": 1},
        "permitted_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "broader_topic_id": {"type": ["string", "null"], "pattern": "^GRW-TOP-[0-9]{3}$"},
        "term_status": {"enum": ["accepted", "deprecated"]},
        "introduced_in": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "deprecated_by": {"type": ["string", "null"], "pattern": "^GRW-TOP-[0-9]{3}$"}
      }
    }
  }
}
